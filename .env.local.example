# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# OpenWeatherMap (used by /api/weather for flight-planning conditions on the map screen)
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# Cron protection (Vercel Cron sends this as a Bearer token)
CRON_SECRET=replace-with-a-long-random-string

# SMS/notification provider (used by NOTAM publish + license expiry notices)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=SkyOpsIL

# Cardcom (billing — src/lib/cardcom/client.ts, src/actions/billing.ts).
# Use SANDBOX terminal credentials for a preview deploy first, and run one
# checkout end to end before trusting this against real cards.
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
# Not used by anything client.ts currently calls (LowProfile/Create,
# LowProfile/GetLpResult, Transactions/Transaction all authenticate with
# ApiName + TerminalNumber only, per Cardcom's own API spec) — kept here in
# case a future Documents/Refund call needs it.
CARDCOM_API_PASSWORD=

# Used to build the checkout's success/failed redirect URLs and the webhook
# URL handed to Cardcom — must be the real deployed origin (not localhost)
# for the webhook to be reachable from Cardcom's servers.
NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.example
